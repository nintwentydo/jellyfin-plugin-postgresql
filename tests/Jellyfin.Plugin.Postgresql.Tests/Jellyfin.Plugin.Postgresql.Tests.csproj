<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Test names read better as sentences than as analyzer-compliant identifiers. -->
    <NoWarn>$(NoWarn);CA1707;SA1600;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    The plugin marks these PrivateAssets="all" so they are not pushed onto consumers, which means
    the tests have to ask for them directly. Keep the versions in step with the plugin's.
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc7" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0-rc7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Jellyfin.Plugin.Postgresql\Jellyfin.Plugin.Postgresql.csproj" />
  </ItemGroup>

</Project>
