<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Postgresql</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <Target Name="RequireCompatibleJellyfinSource" BeforeTargets="PrepareForBuild" Condition="'$(JellyfinSourceRoot)' == ''">
    <Error Text="This custom plugin requires Jellyfin's database restore completion hook. Build with -p:JellyfinSourceRoot=/absolute/path/to/compatible-jellyfin; released 12.0.0 packages do not contain the hook." />
  </Target>

  <!--
    Host-provided assemblies. The server already has these loaded, and shipping a second copy of
    EF Core beside it would be asking for an assembly conflict, so `artifacts` in build.yaml names
    the small set that actually gets packaged. They stay in the local build output because
    `dotnet ef` reflects over it to scaffold migrations. Versions track the server release in
    build.yaml — a mismatch here surfaces as a model that does not match the running schema.
  -->
  <!-- The completion hook is not in released core packages yet; use JellyfinSourceRoot to validate the paired changes. -->
  <ItemGroup Condition="'$(JellyfinSourceRoot)' == ''">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(JellyfinSourceRoot)' != ''">
    <ProjectReference Include="$(JellyfinSourceRoot)/MediaBrowser.Controller/MediaBrowser.Controller.csproj" />
    <ProjectReference Include="$(JellyfinSourceRoot)/MediaBrowser.Model/MediaBrowser.Model.csproj" />
    <ProjectReference Include="$(JellyfinSourceRoot)/src/Jellyfin.Database/Jellyfin.Database.Implementations/Jellyfin.Database.Implementations.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shipped with the plugin: the server has no PostgreSQL driver of its own. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Design-time only: needed by `dotnet ef`, never deployed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
