<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Postgresql</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!--
    Host-provided assemblies. The server already has these loaded, and shipping a second copy of
    EF Core beside it would be asking for an assembly conflict, so `artifacts` in build.yaml names
    the small set that actually gets packaged. They stay in the local build output because
    `dotnet ef` reflects over it to scaffold migrations. Versions track the server release in
    build.yaml — a mismatch here surfaces as a model that does not match the running schema.
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc6" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc6" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0-rc6" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shipped with the plugin: the server has no PostgreSQL driver of its own. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Design-time only: needed by `dotnet ef`, never deployed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
